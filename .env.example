# =========================================================
#  CONFIGURACIÓN GLOBAL DEL SISTEMA (no por tenant)
# =========================================================

# --- IA (Google Gemini via Vercel AI SDK) ---
# Consigue tu API key en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=tu_clave_aqui

# Modelo recomendado: gemini-3.6-flash (rápido, fluido y con function calling)
# Alternativas: gemma-4-26b-a4b-it · gemma-4-31b-it (gemini-2.0/2.5 ya retirados por Google)
MODEL_NAME=gemini-3.6-flash

# --- Servidor ---
# Puerto para el Health Check (necesario para Render/Railway)
PORT=3000

# --- Tenants ---
# Directorio donde viven los JSON de configuración de cada cliente
TENANTS_DIR=src/tenants/tenants

# Tenant al que caen los números de WhatsApp no asignados (o el que
# tiene isDefault: true en su JSON). Vacío = usa el primero de TENANTS_DIR.
DEFAULT_TENANT=demo-showcase

# =========================================================
#  NOTAS
# =========================================================
# - No rodees los valores con comillas a menos que tengan espacios.
# - Los datos por cliente (credenciales de Google, horarios, prompt)
#   NO van aquí: se definen en el JSON de cada tenant dentro de TENANTS_DIR.
# - Las credenciales de Service Account de cada tenant van en
#   src/tenants/credentials/ y se referencian desde el JSON del tenant.
