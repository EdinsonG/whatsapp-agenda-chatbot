# =========================================================
#  CONFIGURACION GLOBAL DEL SISTEMA (no por tenant)
# =========================================================

# --- IA (Google Gemini via Vercel AI SDK) ---
# Consigue tu API key en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=tu_clave_aqui

# Modelo recomendado: gemini-3.6-flash (rapido, fluido y con function calling)
# Alternativas: gemma-4-26b-a4b-it · gemma-4-31b-it (gemini-2.0/2.5 ya retirados por Google)
MODEL_NAME=gemini-3.6-flash

# --- Servidor ---
# Puerto para el Health Check (necesario para Render/Railway)
PORT=3000

# --- Tenants ---
# Directorio donde viven los JSON de configuracion de cada cliente
TENANTS_DIR=src/tenants/tenants

# Tenant al que caen los numeros de WhatsApp no asignados (o el que
# tiene isDefault: true en su JSON). Vacio = usa el primero de TENANTS_DIR.
DEFAULT_TENANT=demo-showcase

# --- Seguridad ---
# API key para autenticar endpoints /tenants. Vacio = sin autenticacion.
API_KEY=

# --- Logging ---
# Nivel de log: fatal · error · warn · info · debug · trace
LOG_LEVEL=info

# --- Persistencia ---
# Ruta del archivo de cola de recordatorios (opcional)
REMINDER_QUEUE_PATH=data/pending-reminders.json
